rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content (home/about/contactInfo/skills docs): anyone can
    // read, only a signed-in admin can write.
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Experience and project entries: publicly readable, admin-only writes.
    match /experience/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact form submissions: visitors can create messages but cannot
    // read, update, or delete them (or anyone else's). Only the admin
    // (via signed-in access) can read/manage them.
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
